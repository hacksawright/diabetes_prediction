// Run after ingest and index_rag.
// RAG_MENTIONS is generated by index_rag. These edges add explicit relations
// backed by selected source passages. MERGE preserves existing graph data.

CREATE CONSTRAINT concept_key IF NOT EXISTS
FOR (c:Concept) REQUIRE c.key IS UNIQUE;

UNWIND [
  {key: 'diabetes', name: 'Đái tháo đường', kind: 'Disease'},
  {key: 'gestational_diabetes', name: 'Đái tháo đường thai kỳ', kind: 'Disease'},
  {key: 'type2', name: 'Đái tháo đường típ 2', kind: 'Disease'},
  {key: 'hba1c', name: 'HbA1c', kind: 'Test'},
  {key: 'glucose_mau_luc_doi', name: 'Glucose máu lúc đói', kind: 'Test'},
  {key: 'nghiem_phap_dung_nap_glucose', name: 'Nghiệm pháp dung nạp glucose', kind: 'Test'},
  {key: 'eye', name: 'Biến chứng mắt', kind: 'Complication'},
  {key: 'kidney', name: 'Biến chứng thận', kind: 'Complication'}
] AS item
MERGE (c:Concept {key: item.key})
SET c.name = item.name, c.kind = item.kind;

UNWIND [
  {source: 'moh-5481', page: 11, disease: 'diabetes', target: 'hba1c', predicate: 'DIAGNOSED_WITH', pattern: 'hba1c'},
  {source: 'moh-5481', page: 11, disease: 'diabetes', target: 'glucose_mau_luc_doi', predicate: 'DIAGNOSED_WITH', pattern: 'glucose huyet tuong luc doi'},
  {source: 'moh-5481', page: 11, disease: 'diabetes', target: 'nghiem_phap_dung_nap_glucose', predicate: 'DIAGNOSED_WITH', pattern: 'nghiem phap dung nap'},
  {source: 'moh-1470', page: 14, disease: 'gestational_diabetes', target: 'nghiem_phap_dung_nap_glucose', predicate: 'SCREENED_WITH', pattern: 'ogtt'},
  {source: 'moh-1470', page: 15, disease: 'gestational_diabetes', target: 'nghiem_phap_dung_nap_glucose', predicate: 'DIAGNOSED_WITH', pattern: 'ogtt'},
  {source: 'moh-1470', page: 30, disease: 'gestational_diabetes', target: 'nghiem_phap_dung_nap_glucose', predicate: 'FOLLOWED_UP_WITH', pattern: 'sau sinh'},
  {source: 'moh-5481', page: 50, disease: 'type2', target: 'eye', predicate: 'HAS_COMPLICATION', pattern: 'bien chung mat|vong mac'},
  {source: 'moh-5481', page: 51, disease: 'type2', target: 'kidney', predicate: 'HAS_COMPLICATION', pattern: 'bien chung than|benh than'}
] AS rule
MATCH (a:Article {source_id: rule.source})-[:HAS_CHUNK]->(ch:Chunk {page_start: rule.page})
WHERE ch.rag_enabled AND replace(ch.normalized, '\n', ' ') =~ ('.*(' + rule.pattern + ').*')
MATCH (d:Concept {key: rule.disease}), (target:Concept {key: rule.target})
MERGE (d)-[r:HAS_KNOWLEDGE {evidence_chunk_id: ch.id, predicate: rule.predicate}]->(target)
SET r.source_url = a.url, r.page = ch.page_start, r.evidence = ch.text,
    r.curated_by = 'diabet-kb';
